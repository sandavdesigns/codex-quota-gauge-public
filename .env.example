# Address of your server's trusted LAN interface. Default exposes loopback only.
LAN_IP=127.0.0.1
# Published host port for dashboard and ESP32 JSON endpoint.
HTTP_PORT=8787
SOURCE=demo
LIMIT_ID=codex
CODEX_VERSION=0.164.0-alpha.11.1

# Remote overlay: create secrets/device-token.txt with one random base64url token
# (for example 32 random bytes encoded as 43 characters), then start Compose
# with both compose.yaml and compose.remote.yaml. Never put the token in this file.
